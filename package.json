{
  "name": "shortdownloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node video-downloader/server.mjs",
    "start": "node video-downloader/server.mjs",
    "setup": "node video-downloader/setup.mjs",
    "build": "tsc --noEmit && vite build --config video-downloader/vite.config.mjs",
    "test": "node --test video-downloader/*.test.mjs",
    "lint": "oxlint src video-downloader",
    "video:dev": "node video-downloader/server.mjs",
    "video:setup": "node video-downloader/setup.mjs",
    "video:test": "node --test video-downloader/*.test.mjs",
    "video:build": "npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "cn": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.21.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "oxlint": "^1.81.0"
  }
}
